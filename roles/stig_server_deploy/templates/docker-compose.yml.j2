services:
  auth:
    image: docker.io/nuwcdivnpt/stig-manager-auth
    ports:
      - "8080:8080"
    restart: always

  db:
    image: docker.io/library/mysql:8.4
    ports:
      - "127.0.0.1:50001:3306"
    environment:
      - MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
      - MYSQL_USER={{ vm_owner }}
      - MYSQL_PASSWORD={{ mysql_root_password }}
      - MYSQL_DATABASE=stigman
    command: --innodb-buffer-pool-size=1024M --sort_buffer_size=16M
    cap_add:
      - SYS_NICE
    volumes:
      - db_data:/var/lib/mysql
    restart: always

  api:
    image: docker.io/nuwcdivnpt/stig-manager:latest
    environment:
      - STIGMAN_OIDC_PROVIDER=http://auth:8080/realms/stigman
      - STIGMAN_CLASSIFICATION=U
      - STIGMAN_DB_HOST=db
      - STIGMAN_DB_PASSWORD={{ mysql_root_password }}
      - STIGMAN_CLIENT_OIDC_PROVIDER=http://{{ ansible_host | default(ansible_facts['default_ipv4']['address']) }}:8080/realms/stigman
      - STIGMAN_CLIENT_WELCOME_TITLE=STIG Manager with Ansible Automation Platform
      - STIGMAN_CLIENT_WELCOME_MESSAGE=Your deployment's Support process can be described here.
      - STIGMAN_CLIENT_WELCOME_LINK=http://link_to_help_pages
    init: true
    ports:
      - "54000:54000"
    depends_on:
      - db
      - auth
    restart: always

volumes:
  db_data: